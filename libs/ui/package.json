{
  "name": "ui",
  "version": "0.1.0",
  "description": "Wspólne komponenty i motywy Angular dla aplikacji BAW",
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./styles/tokens.css": {
      "style": "./styles/tokens.css",
      "default": "./styles/tokens.css"
    },
    "./styles/themes/red.css": {
      "style": "./styles/themes/red.css",
      "default": "./styles/themes/red.css"
    },
    "./styles/themes/blue.css": {
      "style": "./styles/themes/blue.css",
      "default": "./styles/themes/blue.css"
    }
  },
  "scripts": {
    "build": "ng build ui",
    "test": "ng test ui",
    "pack:local": "npm run build && npm pack ./dist",
    "pack:check": "npm run build && npm pack ./dist --dry-run"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.29",
    "@angular/cli": "^21.2.29",
    "@angular/common": "^21.2.26",
    "@angular/compiler": "^21.2.26",
    "@angular/compiler-cli": "^21.2.26",
    "@angular/core": "^21.2.26",
    "@angular/platform-browser": "^21.2.26",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.7",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
