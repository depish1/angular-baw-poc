{
  "name": "docs",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve web-component-poc",
    "build": "ng build web-component-poc",
    "watch": "ng build web-component-poc --watch --configuration development",
    "test": "ng test web-component-poc",
    "build:element": "ng build documents-element",
    "test:element": "npm run build:element && node scripts/smoke-documents-element.mjs",
    "build:lib": "ng build docs-lib",
